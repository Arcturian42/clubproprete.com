# ============================================================================
# ClubProprete.com — variables d'environnement (exemple)
# Copier vers .env.local et remplir. NE JAMAIS committer .env.local.
# ============================================================================

# --- Supabase (projet de TEST) ---------------------------------------------
# Projet de test : https://tefjghkoawbbvtypdeoe.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://tefjghkoawbbvtypdeoe.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service role — SERVEUR UNIQUEMENT (Edge Functions, triggers, admin).
# Ne jamais exposer côté client. Contourne la RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Connexion directe Postgres (migrations, pgTAP en CI/local).
# Format : postgresql://postgres:[PASSWORD]@db.tefjghkoawbbvtypdeoe.supabase.co:5432/postgres
DATABASE_URL=

# Ref du projet lié (supabase link)
SUPABASE_PROJECT_REF=tefjghkoawbbvtypdeoe

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="ClubProprete <noreply@clubproprete.com>"

# --- Autorisation -----------------------------------------------------------
# Emails super_admin (élévation idempotente au login). CSV.
SUPER_ADMIN_EMAILS=clement@pershingsolution.com

# --- Analytics (sans cookies) ----------------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Divers -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Sentry (optionnel)
SENTRY_DSN=
